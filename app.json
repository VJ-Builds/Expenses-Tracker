{
  "expo": {
    "name": "ExpenseIQ",
    "slug": "expenseiq",
    "scheme": "expenseiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expenseiq.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.expenseiq.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": ["arm64-v8a"],
            "extraProguardRules": "-dontwarn expo.modules.**\n-keep class expo.modules.** { *; }\n-dontwarn com.facebook.react.**\n-keep class com.facebook.react.** { *; }\n-dontwarn com.swmansion.reanimated.**\n-keep class com.swmansion.reanimated.** { *; }\n-dontwarn com.swmansion.worklets.**\n-keep class com.swmansion.worklets.** { *; }\n-dontwarn com.reactnativecommunity.asyncstorage.**\n-keep class com.reactnativecommunity.asyncstorage.** { *; }\n-dontwarn com.reactnativecommunity.netinfo.**\n-keep class com.reactnativecommunity.netinfo.** { *; }\n-dontwarn com.horcrux.svg.**\n-keep class com.horcrux.svg.** { *; }"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F0F1A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bb97ed85-338d-471b-9f2a-dd726eefb427"
      }
    }
  }
}
